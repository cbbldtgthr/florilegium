# Copy to .env (gitignored) and set your own paths. `just` loads .env, and
# annot-archive reads the same variables itself; a flag still overrides each.
# Quote values that contain spaces.

# The archive folder: a folder of its own, in a private repository.
ANNOT_ARCHIVE="/path/to/private-repo/archive"

# Your Kindle's My Clippings.txt (or your backup of it).
ANNOT_CLIPPINGS="/path/to/My Clippings.txt"

# The calibre library root, the folder holding metadata.db.
ANNOT_CALIBRE_LIBRARY="/path/to/calibre"
